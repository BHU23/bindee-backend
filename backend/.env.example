NODE_ENV=development
PORT=3000
DATABASE_URL="postgresql://bindee:bindee@localhost:5432/bindee?schema=public"
REDIS_URL=redis://localhost:6379
# Flight number whose reprice returns a changed price (demo/test only)
# INVENTORY_FORCE_PRICE_CHANGE=BN 102
# Seconds a payment started before the hold expired may still complete (default 60)
# HOLD_GRACE_SECONDS=60
# Shared secret for the internal mock-payment callback (X-Callback-Secret, min 16 chars); unset = open
# MOCK_CALLBACK_SECRET=change-me-please-16
