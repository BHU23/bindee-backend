generator client {
  provider = "prisma-client"
  output   = "../generated"
}

datasource db {
  provider = "postgresql"
}

model Example {
  id        String   @id @default(uuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum IdempotencyStatus {
  IN_PROGRESS
  DONE
}

model IdempotencyRecord {
  id          String            @id @default(uuid())
  key         String
  scope       String
  requestHash String            @map("request_hash")
  status      IdempotencyStatus @default(IN_PROGRESS)
  response    Json?
  createdAt   DateTime          @default(now()) @map("created_at")
  updatedAt   DateTime          @updatedAt @map("updated_at")

  @@unique([scope, key])
  @@map("idempotency_record")
}

enum FareFamily {
  LITE
  VALUE
  FLEX
}

enum SeatKind {
  WINDOW
  MIDDLE
  AISLE
  EXIT
}

enum SeatStatus {
  AVAILABLE
  SOLD
}

enum PromoDiscountType {
  PERCENT
  FIXED_PER_PAX
}

model Airport {
  code      String   @id
  name      String
  city      String
  timezone  String   @default("Asia/Bangkok")
  createdAt DateTime @default(now()) @map("created_at")

  origins      Route[] @relation("RouteOrigin")
  destinations Route[] @relation("RouteDestination")

  @@map("airport")
}

model Route {
  id              String   @id @default(uuid())
  originCode      String   @map("origin_code")
  destinationCode String   @map("destination_code")
  international   Boolean  @default(false)
  durationMinutes Int      @map("duration_minutes")
  createdAt       DateTime @default(now()) @map("created_at")

  origin      Airport  @relation("RouteOrigin", fields: [originCode], references: [code])
  destination Airport  @relation("RouteDestination", fields: [destinationCode], references: [code])
  flights     Flight[]

  @@unique([originCode, destinationCode])
  @@map("route")
}

model Flight {
  id          String   @id @default(uuid())
  flightNo    String   @map("flight_no")
  routeId     String   @map("route_id")
  departAt    DateTime @map("depart_at")
  arriveAt    DateTime @map("arrive_at")
  aircraft    String
  priceFactor Decimal  @map("price_factor") @db.Decimal(4, 2)
  stops       Int      @default(0)
  createdAt   DateTime @default(now()) @map("created_at")

  route Route        @relation(fields: [routeId], references: [id])
  fares FlightFare[]
  seats Seat[]

  @@unique([flightNo, departAt])
  @@index([routeId, departAt])
  @@map("flight")
}

model FlightFare {
  id             String     @id @default(uuid())
  flightId       String     @map("flight_id")
  family         FareFamily
  basePrice      Int        @map("base_price")
  airportTax     Int        @map("airport_tax")
  fuelSurcharge  Int        @map("fuel_surcharge")
  serviceFee     Int        @map("service_fee")
  cabinBagKg     Int        @map("cabin_bag_kg")
  checkedBagKg   Int        @map("checked_bag_kg")
  changeAllowed  Boolean    @map("change_allowed")
  changeFee      Int        @map("change_fee")
  refundAllowed  Boolean    @map("refund_allowed")
  refundFee      Int        @map("refund_fee")
  seatIncluded   Boolean    @map("seat_included")
  repriceTrigger Boolean    @default(false) @map("reprice_trigger")

  flight Flight @relation(fields: [flightId], references: [id], onDelete: Cascade)

  @@unique([flightId, family])
  @@map("flight_fare")
}

model Seat {
  id       String     @id @default(uuid())
  flightId String     @map("flight_id")
  row      Int
  letter   String
  kind     SeatKind
  price    Int
  status   SeatStatus @default(AVAILABLE)

  flight    Flight         @relation(fields: [flightId], references: [id], onDelete: Cascade)
  holdItems SeatHoldItem[]

  @@unique([flightId, row, letter])
  @@index([flightId, status])
  @@map("seat")
}

model SeatHold {
  id         String    @id @default(uuid())
  bookingRef String    @map("booking_ref")
  createdAt  DateTime  @default(now()) @map("created_at")
  expiresAt  DateTime  @map("expires_at")
  releasedAt DateTime? @map("released_at")

  items SeatHoldItem[]

  @@index([expiresAt])
  @@map("seat_hold")
}

model SeatHoldItem {
  id       String @id @default(uuid())
  holdId   String @map("hold_id")
  seatId   String @map("seat_id")
  paxIndex Int?   @map("pax_index")

  hold SeatHold @relation(fields: [holdId], references: [id], onDelete: Cascade)
  seat Seat     @relation(fields: [seatId], references: [id], onDelete: Cascade)

  @@unique([holdId, seatId])
  @@index([seatId])
  @@map("seat_hold_item")
}

model SearchSnapshot {
  id        String   @id @default(uuid())
  createdAt DateTime @map("created_at")
  data      Json

  @@map("search_snapshot")
}

/// Fare-selection state of one booking flow; lives as long as its search (20 min) until Confirm booking sets confirmedAt.
model BookingDraft {
  id                        String      @id @default(uuid())
  sessionId                 String      @map("session_id")
  searchId                  String      @map("search_id")
  tripType                  String      @map("trip_type")
  adults                    Int
  children                  Int
  infants                   Int
  searchedAt                DateTime    @map("searched_at")
  outboundFlightId          String?     @map("outbound_flight_id")
  outboundFareFamily        FareFamily? @map("outbound_fare_family")
  outboundPrice             Int?        @map("outbound_price")
  outboundArriveAt          DateTime?   @map("outbound_arrive_at")
  outboundPendingFlightId   String?     @map("outbound_pending_flight_id")
  outboundPendingFareFamily FareFamily? @map("outbound_pending_fare_family")
  returnFlightId            String?     @map("return_flight_id")
  returnFareFamily          FareFamily? @map("return_fare_family")
  returnPrice               Int?        @map("return_price")
  returnPendingFlightId     String?     @map("return_pending_flight_id")
  returnPendingFareFamily   FareFamily? @map("return_pending_fare_family")
  confirmedAt               DateTime?   @map("confirmed_at")
  contactName               String?     @map("contact_name")
  contactEmail              String?     @map("contact_email")
  contactPhone              String?     @map("contact_phone")
  consentPrivacy            Boolean?    @map("consent_privacy")
  consentMarketing          Boolean?    @map("consent_marketing")
  createdAt                 DateTime    @map("created_at")
  updatedAt                 DateTime    @updatedAt @map("updated_at")

  passengers Passenger[]

  @@index([sessionId])
  @@map("booking_draft")
}

model Passenger {
  id               String   @id @default(uuid())
  draftId          String   @map("draft_id")
  position         Int
  type             String
  title            String
  firstName        String   @map("first_name")
  middleName       String?  @map("middle_name")
  lastName         String   @map("last_name")
  dob              String
  gender           String
  nationality      String
  passportNo       String?  @map("passport_no")
  passportCountry  String?  @map("passport_country")
  passportExpiry   String?  @map("passport_expiry")
  infantOfPaxIndex Int?     @map("infant_of_pax_index")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  draft BookingDraft @relation(fields: [draftId], references: [id], onDelete: Cascade)

  @@unique([draftId, position])
  @@map("passenger")
}

model PromoCode {
  code         String            @id
  discountType PromoDiscountType @map("discount_type")
  value        Int
  validUntil   DateTime          @map("valid_until")
  minBaseFare  Int               @map("min_base_fare")
  domesticOnly Boolean           @default(false) @map("domestic_only")

  promotions Promotion[]

  @@map("promo_code")
}

model RecentSearch {
  id         String   @id @default(uuid())
  sessionId  String   @map("session_id")
  queryKey   String   @map("query_key")
  payload    Json
  searchedAt DateTime @map("searched_at")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@unique([sessionId, queryKey])
  @@index([sessionId, searchedAt(sort: Desc)])
  @@map("recent_search")
}

model Promotion {
  id              String   @id
  title           String
  imageUrl        String   @map("image_url")
  originCode      String   @map("origin_code")
  destinationCode String   @map("destination_code")
  promoCode       String   @map("promo_code")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  promo PromoCode @relation(fields: [promoCode], references: [code])

  @@index([promoCode])
  @@map("promotion")
}

model AddonPrice {
  id                 String @id @default(uuid())
  category           String
  code               String
  label              String
  priceDomestic      Int    @map("price_domestic")
  priceInternational Int    @map("price_international")

  @@unique([category, code])
  @@map("addon_price")
}
